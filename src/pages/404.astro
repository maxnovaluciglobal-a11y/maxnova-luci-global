---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { copy, routes } from '../i18n/content';
const { en, es } = copy;
---
<Base t={en} title={`${en.notFound.title} · Maxnova & Luci Global`} noindex>
  <header class="page-head">
    <div class="container">
      <p class="mono notfound__code">404</p>
      <div class="split">
        <section class="notfound">
          <h1>{en.notFound.title}</h1>
          <p>{en.notFound.text}</p>
          <a class="btn btn--ink" href={routes.home.en}>{en.notFound.back}<Arrow /></a>
        </section>
        <section class="notfound" lang="es">
          <h2>{es.notFound.title}</h2>
          <p>{es.notFound.text}</p>
          <a class="btn btn--ink" href={routes.home.es}>{es.notFound.back}<Arrow /></a>
        </section>
      </div>
    </div>
  </header>
</Base>
