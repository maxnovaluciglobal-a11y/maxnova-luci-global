---
import Base from '../../../layouts/Base.astro';
import Arrow from '../../../components/Arrow.astro';
import { copy, routes } from '../../../i18n/content';
const t = copy.es;
---
<Base t={t} title={`${t.contact.h2} · Maxnova & Luci Global`} noindex>
  <header class="page-head">
    <div class="container">
      <h1>{t.contact.sent}</h1>
      <a class="btn btn--ink" href={routes.home[t.lang]}>{t.notFound.back}<Arrow /></a>
    </div>
  </header>
</Base>
