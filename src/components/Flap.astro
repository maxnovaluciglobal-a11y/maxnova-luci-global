---
// Split-flap text: real text for assistive tech, one tile per character for the eye.
// Words never break across lines; each tile flips once on load (see .flap in global.css).
interface Props { text: string; start?: number; class?: string }
const { text, start = 0, class: cls = '' } = Astro.props;
let i = start;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, i: i++ })));
---
<span class={`flap ${cls}`}><span class="sr">{text}</span><span class="flap__tiles" aria-hidden="true">{words.map((w) => (
  <span class="flap__word">{w.map((t) => <span class="flap__tile" style={`--i:${t.i}`}>{t.ch}</span>)}</span>
))}</span></span>
