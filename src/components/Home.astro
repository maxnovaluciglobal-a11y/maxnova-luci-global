---
// Visual language ported from Launch UI (MIT, © 2024 Mikolaj Dobrucki — see THIRD_PARTY_NOTICES.md).
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import { holdings, CONTACT_EMAIL, LEGAL_NAME, type Copy } from '../i18n/content';

import dyposLogo from '../assets/logos/dypos.svg';
import moyiqLogo from '../assets/logos/moyiq.svg';
import esmaliaLogo from '../assets/logos/esmalia.svg';
import dyposShot from '../assets/shots/dypos.png';
import moyiqEn from '../assets/shots/moyiq-en.png';
import moyiqEs from '../assets/shots/moyiq-es.png';
import esmaliaShot from '../assets/shots/esmalia.png';

interface Props { t: Copy }
const { t } = Astro.props;
const year = new Date().getFullYear();

const logos = { dypos: dyposLogo, moyiq: moyiqLogo, esmalia: esmaliaLogo };
const shots = { dypos: dyposShot, moyiq: t.lang === 'es' ? moyiqEs : moyiqEn, esmalia: esmaliaShot };
const live = holdings.filter((h) => h.shot);
const others = holdings.filter((h) => !h.shot);
const isLive = (s: string) => s !== 'building';
---

<a class="skip" href="#main">{t.skip}</a>

<header class="nav">
  <div class="container nav__inner">
    <a class="brand" href={t.path} aria-label={`Maxnova & Luci Global — ${t.nav.label}`}>
      <img src="/logo-mark.svg" alt="" width="26" height="22" class="brand__mark" />
      <span class="brand__name">Maxnova &amp; Luci Global</span>
    </a>
    <nav class="nav__links" aria-label={t.nav.label}>
      <a href="#portfolio">{t.nav.portfolio}</a>
      <a href="#services">{t.nav.services}</a>
      <a href="#company" class="nav__keep">{t.nav.company}</a>
      <a href={t.altPath} hreflang={t.lang === 'en' ? 'es' : 'en'} lang={t.lang === 'en' ? 'es' : 'en'}>
        <span aria-hidden="true">{t.altShort}</span><span class="sr">{t.altLabel}</span>
      </a>
      <a class="btn btn--primary btn--sm" href="#contact">{t.nav.cta}</a>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1">
  <section class="hero">
    <div class="container hero__inner">
      <a class="badge appear" href="#portfolio">
        <span class="badge__muted">{t.cover.badge}</span>
        <span class="badge__link">{t.cover.badgeLink}<Arrow /></span>
      </a>
      <h1 class="hero__title appear">{t.cover.h1}</h1>
      <p class="hero__lead appear appear--1">{t.cover.lead}</p>
      <div class="hero__actions appear appear--2">
        <a class="btn btn--primary btn--lg" href="#contact">{t.cover.primary}<Arrow /></a>
        <a class="btn btn--glow btn--lg" href="#portfolio">{t.cover.secondary}</a>
      </div>

      <div class="hero__mockup appear appear--3">
        <div class="frame">
          <div class="mosaic">
            {live.map((h, i) => (
              <a class={`mosaic__tile mosaic__tile--${i}`} href={`#${h.id}`} aria-label={`${h.name} — ${t.portfolio.open}`}>
                <Picture src={shots[h.shot!]} formats={['avif', 'webp']} fallbackFormat="jpg"
                  widths={i === 0 ? [720, 1080, 1440] : [480, 720, 960]}
                  sizes={i === 0 ? '(min-width: 1100px) 760px, 92vw' : '(min-width: 1100px) 440px, 46vw'}
                  alt={t.portfolio.shotAlt(h.name)} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                <span class="mosaic__label"><span class={`dot ${isLive(h.status) ? 'is-live' : ''}`} aria-hidden="true"></span>{h.name}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="glow" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="logos" aria-labelledby="schedule-title">
    <div class="container">
      <h2 id="schedule-title" class="logos__title">{t.cover.scheduleTitle}</h2>
      <ul class="logos__list">
        {holdings.map((h) => (
          <li>
            <a href={`#${h.id}`} class="logos__item">
              {h.logo ? <img src={logos[h.logo].src} alt="" width="24" height="24" /> : <span class="logos__blank" aria-hidden="true"></span>}
              <span class="logos__name">{h.name}</span>
              <span class={`pill ${isLive(h.status) ? 'pill--live' : ''}`}>{t.status[h.status]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="portfolio" aria-labelledby="portfolio-title">
    <div class="container">
      <div class="heading">
        <h2 id="portfolio-title">{t.portfolio.h2}</h2>
        <p>{t.portfolio.intro}</p>
      </div>

      <div class="features">
        {live.map((h, i) => (
          <article class={`feature ${i % 2 ? 'feature--flip' : ''}`} id={h.id} aria-labelledby={`${h.id}-name`}>
            <div class="feature__text">
              <div class="feature__brand">
                {h.logo && <img src={logos[h.logo].src} alt="" width="36" height="36" loading="lazy" />}
                <span class={`pill ${isLive(h.status) ? 'pill--live' : ''}`}>{t.status[h.status]}</span>
              </div>
              <h3 id={`${h.id}-name`}>{h.name}</h3>
              <p class="feature__summary">{h.summary[t.lang]}</p>
              <dl class="facts">
                <div><dt>{t.cover.cols.sector}</dt><dd>{h.sector[t.lang]}</dd></div>
                <div><dt>{t.portfolio.market}</dt><dd>{h.market[t.lang]}</dd></div>
              </dl>
              <a class="btn btn--glow" href={h.url} target="_blank" rel="noopener">{t.portfolio.open} {h.urlLabel}<Arrow out /></a>
            </div>
            <figure class="feature__media">
              <div class="frame frame--sm">
                <div class="mockup">
                  <Picture src={shots[h.shot!]} formats={['avif', 'webp']} fallbackFormat="jpg"
                    widths={[720, 1080, 1440]} sizes="(min-width: 1100px) 720px, 92vw"
                    alt={t.portfolio.shotAlt(h.name)} loading="lazy" decoding="async" />
                </div>
              </div>
              <figcaption>{t.portfolio.fig(i + 1, h.urlLabel!)}</figcaption>
            </figure>
          </article>
        ))}
      </div>

      <div class="cards cards--2">
        {others.map((h) => (
          <article class="card glass" id={h.id} aria-labelledby={`${h.id}-name`}>
            <div class="card__top">
              <h3 id={`${h.id}-name`}>{h.name}</h3>
              <span class={`pill ${isLive(h.status) ? 'pill--live' : ''}`}>{t.status[h.status]}</span>
            </div>
            <p>{h.summary[t.lang]}</p>
            <dl class="facts facts--row">
              <div><dt>{t.cover.cols.sector}</dt><dd>{h.sector[t.lang]}</dd></div>
              <div><dt>{t.portfolio.market}</dt><dd>{h.market[t.lang]}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="heading">
        <h2 id="services-title">{t.services.h2}</h2>
        <p>{t.services.intro}</p>
      </div>
      <div class="cards cards--2">
        {t.services.items.map((s) => (
          <article class="card glass">
            <h3>{s.title}</h3>
            <p class="card__who">{s.who}</p>
            <p>{s.what}</p>
          </article>
        ))}
      </div>

      <h3 class="steps__title">{t.process.h2}</h3>
      <ol class="steps">
        {t.process.steps.map((s, i) => (
          <li><span class="steps__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><strong>{s.title}</strong><p>{s.text}</p></li>
        ))}
      </ol>
      <p class="center"><a class="btn btn--primary btn--lg" href="#contact">{t.services.cta}<Arrow /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="letter-title">
    <div class="container">
      <article class="letter glass">
        <h2 id="letter-title">{t.letter.h2}</h2>
        {t.letter.body.map((p) => <p>{p}</p>)}
        <p class="letter__sign"><strong>{t.letter.name}</strong><span>{t.letter.role}, {LEGAL_NAME}</span></p>
      </article>
    </div>
  </section>

  <section class="section" id="company" aria-labelledby="company-title">
    <div class="container split">
      <div class="heading heading--left">
        <h2 id="company-title">{t.company.h2}</h2>
      </div>
      <dl class="rows glass">
        {t.company.rows.map((r) => (
          <div><dt>{r.k}</dt><dd>{r.href ? <a href={r.href}>{r.v}</a> : r.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split">
      <div class="heading heading--left">
        <h2 id="faq-title">{t.faq.h2}</h2>
      </div>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary><h3>{f.q}</h3><span class="faq__chev" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta" id="contact" aria-labelledby="contact-title">
    <div class="glow glow--center" aria-hidden="true"></div>
    <div class="container cta__inner">
      <div class="heading">
        <h2 id="contact-title">{t.contact.h2}</h2>
        <p>{t.contact.intro} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      </div>
      <form class="form glass" method="post" action="/api/contact" data-contact
        data-sending={t.contact.sending} data-sent={t.contact.sent} data-invalid={t.contact.invalid}
        data-error={`${t.contact.error} ${CONTACT_EMAIL}.`}>
        <input type="hidden" name="lang" value={t.lang} />
        <div class="form__trap" aria-hidden="true">
          <label>Leave empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="form__row">
          <label class="field"><span>{t.contact.fields.name}</span>
            <input type="text" name="name" required autocomplete="name" maxlength="120" /></label>
          <label class="field"><span>{t.contact.fields.email}</span>
            <input type="email" name="email" required autocomplete="email" maxlength="200" /></label>
        </div>
        <div class="form__row">
          <label class="field"><span>{t.contact.fields.company} <i>({t.contact.fields.optional})</i></span>
            <input type="text" name="company" autocomplete="organization" maxlength="160" /></label>
          <label class="field"><span>{t.contact.fields.topic}</span>
            <select name="service" required>
              <option value="" selected disabled>{t.contact.fields.choose}</option>
              {t.contact.topics.map((o) => <option>{o}</option>)}
            </select></label>
        </div>
        <label class="field"><span>{t.contact.fields.message}</span>
          <textarea name="message" required rows="5" maxlength="5000"></textarea></label>
        <div class="form__foot">
          <button class="btn btn--primary btn--lg" type="submit">{t.contact.submit}<Arrow /></button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand"><img src="/logo-mark.svg" alt="" width="22" height="19" /> {LEGAL_NAME}</p>
    <p>{t.footer.talent} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p>© {year} {LEGAL_NAME}. {t.footer.rights} · <a href={t.altPath} hreflang={t.lang === 'en' ? 'es' : 'en'}>{t.altLabel}</a></p>
  </div>
</footer>

<script>
  // Contact form: send as JSON, show success only after the API answers 200.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.innerHTML;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = form.dataset.invalid!;
        status.dataset.state = 'error';
        form.reportValidity();
        return;
      }
      button.disabled = true;
      button.textContent = form.dataset.sending!;
      status.textContent = '';
      delete status.dataset.state;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.sent!;
        status.dataset.state = 'ok';
      } catch {
        status.textContent = form.dataset.error!;
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.innerHTML = label;
      }
    });
  }
</script>
