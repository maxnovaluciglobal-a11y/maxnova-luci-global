---
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import Flap from './Flap.astro';
import { holdings, CONTACT_EMAIL, LEGAL_NAME, type Copy } from '../i18n/content';

import dyposLogo from '../assets/logos/dypos.svg';
import moyiqLogo from '../assets/logos/moyiq.svg';
import esmaliaLogo from '../assets/logos/esmalia.svg';
import dyposShot from '../assets/shots/dypos.png';
import moyiqEn from '../assets/shots/moyiq-en.png';
import moyiqEs from '../assets/shots/moyiq-es.png';
import esmaliaShot from '../assets/shots/esmalia.png';

interface Props { t: Copy }
const { t } = Astro.props;
const year = new Date().getFullYear();

const logos = { dypos: dyposLogo, moyiq: moyiqLogo, esmalia: esmaliaLogo };
const shots = { dypos: dyposShot, moyiq: t.lang === 'es' ? moyiqEs : moyiqEn, esmalia: esmaliaShot };
const lit = (s: string) => s !== 'building';
---

<a class="skip" href="#main">{t.skip}</a>

<header class="board" id="top">
  <div class="wrap board__bar">
    <a class="brand" href={t.path} aria-label={`Maxnova & Luci Global — ${t.nav.label}`}>
      <img src="/logo-mark.svg" alt="" width="30" height="26" class="brand__mark" />
      <span class="brand__name">Maxnova &amp; Luci Global</span>
    </a>
    <nav class="topnav" aria-label={t.nav.label}>
      <a href="#portfolio">{t.nav.portfolio}</a>
      <a href="#services">{t.nav.services}</a>
      <a href="#company" class="topnav__keep">{t.nav.company}</a>
      <a href={t.altPath} hreflang={t.lang === 'en' ? 'es' : 'en'} lang={t.lang === 'en' ? 'es' : 'en'}>
        <span aria-hidden="true">{t.altShort}</span><span class="sr">{t.altLabel}</span>
      </a>
      <a class="key key--sm" href="#contact">{t.nav.cta}</a>
    </nav>
  </div>

  <div class="wrap board__body" id="main" tabindex="-1">
    <h1 class="board__h1"><Flap text={t.cover.h1} /></h1>
    <div class="board__intro">
      <p class="board__lead">{t.cover.lead}</p>
      <div class="board__actions">
        <a class="key" href="#contact">{t.cover.primary}<Arrow /></a>
        <a class="textlink" href="#portfolio">{t.cover.secondary}<Arrow down /></a>
      </div>
    </div>

    <section class="departures" aria-labelledby="departures-title">
      <h2 id="departures-title" class="departures__title">{t.cover.scheduleTitle}</h2>
      <table>
        <colgroup><col class="c-company" /><col class="c-sector" /><col class="c-market" /><col class="c-status" /></colgroup>
        <thead>
          <tr>
            <th scope="col">{t.cover.cols.company}</th>
            <th scope="col" class="col-sector">{t.cover.cols.sector}</th>
            <th scope="col" class="col-market">{t.cover.cols.market}</th>
            <th scope="col">{t.cover.cols.status}</th>
          </tr>
        </thead>
        <tbody>
          {holdings.map((h, r) => (
            <tr class={lit(h.status) ? 'is-lit' : ''} style={`--r:${r}`}>
              <th scope="row"><a href={`#${h.id}`}><span class="module module--name">{h.name}</span></a></th>
              <td class="col-sector"><span class="module">{h.sector[t.lang]}</span></td>
              <td class="col-market"><span class="module" title={h.market[t.lang]}>{h.code}</span></td>
              <td><span class="module module--status"><span class="lamp" aria-hidden="true"></span>{t.status[h.status]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</header>

<main>
  <section class="section" id="portfolio" aria-labelledby="portfolio-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="portfolio-title">{t.portfolio.h2}</h2>
        <p class="section__intro">{t.portfolio.intro}</p>
      </div>

      <div class="gates">
        {holdings.map((h) => {
          const n = holdings.filter((x) => x.shot).indexOf(h) + 1;
          return (
            <article class={`gate ${h.shot ? 'gate--shot' : 'gate--line'}`} id={h.id} aria-labelledby={`${h.id}-name`}>
              <header class="gate__head">
                {h.logo && <img class="gate__logo" src={logos[h.logo].src} alt="" width="36" height="36" loading="lazy" />}
                <h3 id={`${h.id}-name`}>{h.name}</h3>
                <p class={`gate__status ${lit(h.status) ? 'is-lit' : ''}`}><span class="lamp" aria-hidden="true"></span>{t.status[h.status]}</p>
              </header>
              <div class="gate__body">
                <div class="gate__text">
                  <dl class="gate__facts">
                    <div><dt>{t.cover.cols.sector}</dt><dd>{h.sector[t.lang]}</dd></div>
                    <div><dt>{t.portfolio.market}</dt><dd>{h.market[t.lang]}</dd></div>
                  </dl>
                  <p class="gate__summary">{h.summary[t.lang]}</p>
                  {h.url && (
                    <a class="textlink" href={h.url} target="_blank" rel="noopener">
                      {t.portfolio.open} {h.urlLabel}<Arrow out />
                    </a>
                  )}
                </div>
                {h.shot && (
                  <figure class="screen">
                    <div class="screen__view">
                      <Picture
                        src={shots[h.shot]}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpg"
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 1100px) 820px, 92vw"
                        alt={t.portfolio.shotAlt(h.name)}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <figcaption>{t.portfolio.fig(n, h.urlLabel!)}</figcaption>
                  </figure>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="services-title">{t.services.h2}</h2>
        <p class="section__intro">{t.services.intro}</p>
      </div>
      <dl class="routes">
        {t.services.items.map((s) => (
          <div class="route">
            <dt>{s.title}</dt>
            <dd><p class="route__who">{s.who}</p><p>{s.what}</p></dd>
          </div>
        ))}
      </dl>
      <p class="section__cta"><a class="key" href="#contact">{t.services.cta}<Arrow /></a></p>

      <div class="steps">
        <h3 class="steps__title">{t.process.h2}</h3>
        <ol>
          {t.process.steps.map((s, i) => (
            <li><span class="steps__n" aria-hidden="true">{i + 1}</span><strong>{s.title}</strong><p>{s.text}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--notice" aria-labelledby="letter-title">
    <div class="wrap">
      <article class="notice">
        <h2 id="letter-title">{t.letter.h2}</h2>
        <div class="notice__body">
          {t.letter.body.map((p) => <p>{p}</p>)}
          <p class="notice__sign"><strong>{t.letter.name}</strong><span>{t.letter.role}, {LEGAL_NAME}</span></p>
        </div>
      </article>
    </div>
  </section>

  <section class="section" id="company" aria-labelledby="company-title">
    <div class="wrap split">
      <h2 id="company-title">{t.company.h2}</h2>
      <dl class="ledger">
        {t.company.rows.map((r) => (
          <div><dt>{r.k}</dt><dd>{r.href ? <a href={r.href}>{r.v}</a> : r.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap split">
      <h2 id="faq-title">{t.faq.h2}</h2>
      <div class="faq">
        {t.faq.items.map((f) => (
          <details>
            <summary><h3>{f.q}</h3><span class="faq__plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section desk" id="contact" aria-labelledby="contact-title">
    <div class="wrap split">
      <div class="desk__head">
        <h2 id="contact-title">{t.contact.h2}</h2>
        <p>{t.contact.intro}</p>
        <p><a class="desk__mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      </div>
      <form class="form" method="post" action="/api/contact" data-contact
        data-sending={t.contact.sending} data-sent={t.contact.sent} data-invalid={t.contact.invalid}
        data-error={`${t.contact.error} ${CONTACT_EMAIL}.`}>
        <input type="hidden" name="lang" value={t.lang} />
        <div class="form__trap" aria-hidden="true">
          <label>Leave empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="form__row">
          <label class="field"><span>{t.contact.fields.name}</span>
            <input type="text" name="name" required autocomplete="name" maxlength="120" /></label>
          <label class="field"><span>{t.contact.fields.email}</span>
            <input type="email" name="email" required autocomplete="email" maxlength="200" /></label>
        </div>
        <div class="form__row">
          <label class="field"><span>{t.contact.fields.company} <i>({t.contact.fields.optional})</i></span>
            <input type="text" name="company" autocomplete="organization" maxlength="160" /></label>
          <label class="field"><span>{t.contact.fields.topic}</span>
            <select name="service" required>
              <option value="" selected disabled>{t.contact.fields.choose}</option>
              {t.contact.topics.map((o) => <option>{o}</option>)}
            </select></label>
        </div>
        <label class="field"><span>{t.contact.fields.message}</span>
          <textarea name="message" required rows="6" maxlength="5000"></textarea></label>
        <div class="form__foot">
          <button class="key" type="submit">{t.contact.submit}<Arrow /></button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer__wrap">
    <p class="footer__brand"><img src="/logo-mark.svg" alt="" width="24" height="21" /> {LEGAL_NAME}</p>
    <p>{t.footer.talent} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p>© {year} {LEGAL_NAME}. {t.footer.rights} · <a href={t.altPath} hreflang={t.lang === 'en' ? 'es' : 'en'}>{t.altLabel}</a></p>
  </div>
</footer>

<script>
  // Contact form: send as JSON, show success only after the API answers 200.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.innerHTML;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = form.dataset.invalid!;
        status.dataset.state = 'error';
        form.reportValidity();
        return;
      }
      button.disabled = true;
      button.textContent = form.dataset.sending!;
      status.textContent = '';
      delete status.dataset.state;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.sent!;
        status.dataset.state = 'ok';
      } catch {
        status.textContent = form.dataset.error!;
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.innerHTML = label;
      }
    });
  }
</script>
