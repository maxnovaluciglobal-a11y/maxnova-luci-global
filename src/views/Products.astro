---
import Arrow from '../components/Arrow.astro';
import ContactForm from '../components/ContactForm.astro';
import ProductShot from './ProductShot.astro';
import { products, screenCaptions, type Copy } from '../i18n/content';

interface Props { t: Copy }
const { t } = Astro.props;
const c = t.productsPage;
---
<header class="page-head">
  <div class="container">
    <h1>{c.h1}</h1>
    <p>{c.lead}</p>
  </div>
</header>

<div class="container products" data-status data-checking={t.network.checking} data-online={t.network.online} data-offline={t.network.offline}
  data-nodata={t.network.noData} data-unavailable={t.network.unavailable} data-checked={t.network.checkedAt('{t}')}>
  {products.map((p, i) => (
    <article class="product" id={p.id} aria-labelledby={`${p.id}-name`}>
      <div class="product__text">
        <h2 id={`${p.id}-name`}>{p.name}</h2>
        <p class="product__summary">{p.summary[t.lang]}</p>
        <dl class="facts">
          <div class="facts__live" data-node={p.id} data-state="unknown"><dt>{c.status}</dt><dd><span class="node__dot" aria-hidden="true"></span><span data-node-label>{t.network.noData}</span> <span class="mono" data-node-ms></span></dd></div>
          <div><dt>{c.sector}</dt><dd>{p.sector[t.lang]}</dd></div>
          <div><dt>{c.market}</dt><dd>{p.market[t.lang]}</dd></div>
          <div><dt>{c.price}</dt><dd>{p.price[t.lang]}</dd></div>
          <div><dt>{c.notYet}</dt><dd>{p.notYet[t.lang]}</dd></div>
        </dl>
        <div class="product__actions">
          <a class="btn btn--ink" href={p.demo} rel="noopener" target="_blank">{c.openDemo}<Arrow out /></a>
          <a class="link" href={p.url} rel="noopener" target="_blank">{c.openSite} {p.urlLabel}<Arrow out /></a>
        </div>
      </div>
      <figure class="product__media">
        <ProductShot t={t} product={p} sizes="(min-width: 1000px) 760px, 92vw" eager={i === 0} />
        <figcaption>{screenCaptions[p.id][t.lang]}</figcaption>
      </figure>
    </article>
  ))}

  <section class="other" aria-labelledby="other-title">
    <h2 id="other-title">{c.otherH2}</h2>
    <dl>
      {c.other.map((o) => <div><dt>{o.title}</dt><dd>{o.text}</dd></div>)}
    </dl>
  </section>

  <section class="early" aria-labelledby="early-title">
    <h2 id="early-title">{c.earlyH2}</h2>
    <p>{c.early}</p>
  </section>
</div>

<ContactForm t={t} />

<script>
  import { startStatus } from '../scripts/status';
  startStatus();
</script>
