---
import { Image } from 'astro:assets';
import founderPhoto from '../assets/founder.png';
import Arrow from '../components/Arrow.astro';
import ContactForm from '../components/ContactForm.astro';
import { routes, lastmod, formatDate, type Copy } from '../i18n/content';
interface Props { t: Copy }
const { t } = Astro.props;
const c = t.founderPage;
---
<header class="page-head">
  <div class="container">
    <p class="article__date">{t.legal.updated}: <time datetime={lastmod.founder}>{formatDate(lastmod.founder, t.lang, t.dateFmt)}</time></p>
    <h1>{c.h1}</h1>
    <p class="page-head__lead">{c.lead}</p>
  </div>
</header>

<div class="container co-founder" style="margin-top:40px">
  <Image class="co-founder__photo" src={founderPhoto} alt={t.companyPage.founderAlt} widths={[320, 640]} sizes="(min-width: 1120px) 420px, 320px" loading="eager" />
  <article class="article article--flush">
    {c.sections.map((s) => <section><h2>{s.h}</h2>{s.p.map((p) => <p>{p}</p>)}</section>)}
  </article>
</div>

<section class="section" aria-labelledby="tl-title">
  <div class="container">
    <div class="news">
      <div class="news__h"><h2 id="tl-title">{c.timelineH2}</h2><a class="link" href={routes.log[t.lang]}>{t.home.logLink}<Arrow /></a></div>
      <ol class="entries">
        {c.timeline.map((e) => <li class="entries--two"><time datetime={e.d}>{formatDate(e.d, t.lang, t.dateFmt)}</time><span class="entries__txt">{e.t}</span></li>)}
      </ol>
    </div>
  </div>
</section>

<section class="section contact-wrap">
  <div class="container"><ContactForm t={t} /></div>
</section>
