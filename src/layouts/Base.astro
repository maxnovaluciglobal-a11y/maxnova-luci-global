---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/martian-mono/wght.css';
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { SITE_URL, BRAND_NAME, LEGAL_NAME, DOC_NUMBER, SUNBIZ_URL, routes, type Copy, type PageKey } from '../i18n/content';

interface Props {
  t: Copy;
  page?: PageKey;
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const { t, page, title = t.meta[page ?? 'home'].title, description = t.meta[page ?? 'home'].description, noindex = false, jsonLd = [] } = Astro.props;
const key = page ?? 'home';
const canonical = new URL(routes[key][t.lang], SITE_URL).href;
const enUrl = new URL(routes[key].en, SITE_URL).href;
const esUrl = new URL(routes[key].es, SITE_URL).href;
const ogImage = new URL(`/og-${t.lang}.png`, SITE_URL).href;
const altHref = routes[key][t.altLang];
const links: { key: PageKey; label: string }[] = [
  { key: 'products', label: t.nav.products },
  { key: 'services', label: t.nav.services },
  { key: 'company', label: t.nav.company },
  { key: 'log', label: t.nav.log },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta name="theme-color" content="#e6e8e4" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script defer src="/_vercel/insights/script.js" is:inline></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="nav">
      <div class="container nav__inner">
        <a class="brand" href={routes.home[t.lang]}>
          <img src="/logo-mark.svg" alt="" width="28" height="24" />
          <span>{BRAND_NAME}</span>
        </a>
        <details class="nav__menu">
          <summary>{t.nav.menu}</summary>
          <nav aria-label={t.nav.label}>
            {links.map((l) => (
              <a href={routes[l.key][t.lang]} aria-current={l.key === page ? 'page' : undefined}>{l.label}</a>
            ))}
            <a href={altHref} hreflang={t.altLang} lang={t.altLang}>{t.altLabel}</a>
          </nav>
        </details>
        <nav class="nav__links" aria-label={t.nav.label}>
          {links.map((l) => (
            <a href={routes[l.key][t.lang]} aria-current={l.key === page ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href={altHref} hreflang={t.altLang} lang={t.altLang}><span aria-hidden="true">{t.altShort}</span><span class="sr">{t.altLabel}</span></a>
        </nav>
        <a class="btn btn--ink btn--sm nav__cta" href="#contact">{t.nav.cta}</a>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__grid">
        <div>
          <p class="footer__brand"><img src="/logo-mark.svg" alt="" width="24" height="21" /> {LEGAL_NAME}</p>
          <p>{t.footer.registered} · <a href={SUNBIZ_URL} rel="noopener" target="_blank"><span class="mono">{DOC_NUMBER}</span><Arrow out /></a></p>
        </div>
        <nav aria-label={t.footer.sections}>
          {links.map((l) => <a href={routes[l.key][t.lang]}>{l.label}</a>)}
        </nav>
        <nav aria-label={t.footer.legal}>
          <a href={routes.privacy[t.lang]}>{t.footer.privacy}</a>
          <a href={routes.terms[t.lang]}>{t.footer.terms}</a>
          <a href={altHref} hreflang={t.altLang} lang={t.altLang}>{t.altLabel}</a>
        </nav>
        <p class="footer__copy">© {year} {LEGAL_NAME}. {t.footer.rights}</p>
      </div>
    </footer>
  </body>
</html>
