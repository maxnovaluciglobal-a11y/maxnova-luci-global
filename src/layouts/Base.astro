---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import { SITE_URL, type Copy } from '../i18n/content';

interface Props {
  t: Copy;
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const { t, title = t.meta.title, description = t.meta.description, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(t.path, SITE_URL).href;
const enUrl = new URL('/', SITE_URL).href;
const esUrl = new URL('/es/', SITE_URL).href;
const ogImage = new URL(`/og-${t.lang}.png`, SITE_URL).href;
---

<!doctype html>
<html lang={t.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maxnova & Luci Global" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script defer src="/_vercel/insights/script.js" is:inline></script>
  </head>
  <body>
    <slot />
  </body>
</html>
