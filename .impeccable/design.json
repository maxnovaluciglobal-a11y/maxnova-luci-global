  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single primary action: cobalt pill with a nudging arrow.",
      "html": "<a class=\"ds-btn ds-btn--primary\" href=\"#\">See the products <svg class=\"ds-arrow\" viewBox=\"0 0 16 16\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M3 8h9M8.5 4.5 12 8l-3.5 3.5\"/></svg></a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;font:600 1rem/1 var(--sans);text-decoration:none;white-space:nowrap;cursor:pointer;border:1.5px solid transparent;transition:background-color .2s,color .2s,border-color .2s}.ds-btn .ds-arrow{transition:transform .25s cubic-bezier(.2,.8,.2,1)}.ds-btn:hover .ds-arrow{transform:translateX(2px)}.ds-btn--primary{background:var(--cobalt);color:#fff}.ds-btn--primary:hover{background:var(--cobalt-deep)}.ds-btn:focus-visible{outline:3px solid var(--cobalt);outline-offset:2px}"
    },
    {
      "name": "Line Button",
      "kind": "button",
      "refersTo": "button-line",
      "description": "Secondary action on light ground; fills ink on hover.",
      "html": "<a class=\"ds-btn-line\" href=\"#\">Talk about your project</a>",
      "css": ".ds-btn-line{display:inline-flex;align-items:center;min-height:46px;padding:0 22px;border-radius:999px;border:1.5px solid var(--ink);color:var(--ink);background:transparent;font:600 1rem/1 var(--sans);text-decoration:none;transition:background-color .2s,color .2s}.ds-btn-line:hover{background:var(--ink);color:#fff}.ds-btn-line:focus-visible{outline:3px solid var(--cobalt);outline-offset:2px}"
    },
    {
      "name": "Light Button",
      "kind": "button",
      "refersTo": "button-light",
      "description": "Primary action on cobalt or ink fields.",
      "html": "<div class=\"ds-on-cobalt\"><a class=\"ds-btn-light\" href=\"#\">Write to us</a></div>",
      "css": ".ds-on-cobalt{background:var(--cobalt);padding:20px;border-radius:16px}.ds-btn-light{display:inline-flex;align-items:center;min-height:46px;padding:0 22px;border-radius:999px;background:#fff;color:var(--cobalt-ink);font:600 1rem/1 var(--sans);text-decoration:none;transition:background-color .2s}.ds-btn-light:hover{background:var(--cobalt-tint)}.ds-btn-light:focus-visible{outline:3px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Status Pill",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Measured product status: grey until /api/status answers, green with latency when online.",
      "html": "<span class=\"ds-pill\"><span class=\"ds-pill__dot\"></span>No data</span> <span class=\"ds-pill is-on\"><span class=\"ds-pill__dot\"></span>Online <b>· 342 ms</b></span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 12px;border-radius:999px;background:#f1f3f5;color:var(--ink);font:500 .8125rem/1 var(--sans);white-space:nowrap}.ds-pill b{font-weight:700;font-variant-numeric:tabular-nums}.ds-pill__dot{width:8px;height:8px;border-radius:50%;background:#a3aab5}.ds-pill.is-on .ds-pill__dot{background:var(--ok);box-shadow:0 0 0 3px rgb(18 161 80 / .16)}"
    },
    {
      "name": "Product Cell",
      "kind": "card",
      "refersTo": "cell",
      "description": "White bento cell that floods with the product's own colour on hover or focus.",
      "html": "<article class=\"ds-cell\" tabindex=\"0\"><h3>Esmalia</h3><p class=\"ds-muted\">Dental clinics</p><a class=\"ds-open\" href=\"#\">Open</a></article>",
      "css": ".ds-cell{--hb:var(--esmalia);display:flex;flex-direction:column;gap:14px;max-width:320px;padding:22px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:16px;transition:background-color .28s,color .28s,border-color .28s}.ds-cell h3{margin:0;font:700 1.3125rem/1.1 var(--display);letter-spacing:-.01em}.ds-cell p{margin:0}.ds-muted{color:var(--muted)}.ds-cell:hover,.ds-cell:focus-within{background:var(--hb);border-color:var(--hb);color:#fff}.ds-cell:hover .ds-muted,.ds-cell:focus-within .ds-muted{color:#ffe3e7}.ds-open{align-self:flex-start;display:inline-flex;align-items:center;min-height:42px;padding:0 18px;border-radius:999px;border:1.5px solid currentColor;color:inherit;font:600 .9375rem/1 var(--sans);text-decoration:none}.ds-open:hover{background:#fff;color:var(--esmalia);border-color:#fff}"
    },
    {
      "name": "Cobalt Field Cell",
      "kind": "card",
      "refersTo": "cell-cobalt",
      "description": "Cobalt owning a whole cell: the AI service.",
      "html": "<article class=\"ds-cobalt\"><h3>AI software for your company</h3><a class=\"ds-case\" href=\"#\">Answer customers on WhatsApp <span>See</span></a></article>",
      "css": ".ds-cobalt{display:flex;flex-direction:column;gap:16px;max-width:340px;padding:22px;background:var(--cobalt);color:#fff;border-radius:16px}.ds-cobalt h3{margin:0;font:700 1.625rem/1.08 var(--display);letter-spacing:-.02em}.ds-case{display:flex;justify-content:space-between;gap:10px;align-items:center;min-height:44px;padding:10px 14px;border-radius:12px;border:1.5px solid rgb(255 255 255 / .45);background:rgb(255 255 255 / .08);color:#fff;font:500 .9375rem/1.3 var(--sans);text-decoration:none;transition:background-color .2s,color .2s}.ds-case span{font-size:.8125rem;font-weight:600}.ds-case:hover{background:#fff;color:var(--cobalt)}.ds-case:focus-visible{outline:3px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Log filter; pressed state fills ink.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">All</button> <button class=\"ds-chip\" aria-pressed=\"false\"><i style=\"background:var(--dypos)\"></i>DypOS</button>",
      "css": ".ds-chip{min-height:38px;padding:0 16px;border-radius:999px;border:1.5px solid var(--line-2);background:var(--surface);color:var(--ink);font:600 .875rem/1 var(--sans);cursor:pointer;display:inline-flex;align-items:center;gap:8px}.ds-chip i{width:9px;height:9px;border-radius:50%}.ds-chip:hover{border-color:var(--ink)}.ds-chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:#fff}.ds-chip:focus-visible{outline:3px solid var(--cobalt);outline-offset:2px}"
    },
    {
      "name": "Field on Ink",
      "kind": "input",
      "refersTo": "input-on-ink",
      "description": "Contact form field on the ink card.",
      "html": "<div class=\"ds-ink\"><label class=\"ds-field\"><span>Email</span><input type=\"email\" placeholder=\"you@company.com\"></label></div>",
      "css": ".ds-ink{background:var(--ink);padding:24px;border-radius:16px;max-width:360px}.ds-field{display:flex;flex-direction:column;gap:6px}.ds-field span{font:600 .875rem/1.2 var(--sans);color:#e6eaf0}.ds-field input{min-height:46px;border-radius:12px;border:1.5px solid #3a4350;background:var(--ink-2);color:#fff;padding:0 14px;font:400 1rem var(--sans)}.ds-field input:focus{outline:none;border-color:#7d9bff;box-shadow:0 0 0 3px rgb(125 155 255 / .3)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "",
      "description": "Sticky translucent bar: cobalt monogram, text links, language pill, primary CTA.",
